{
  "info": {
    "_postman_id": "meeting-room-booking-api",
    "name": "Meeting Room Booking API",
    "description": "Postman collection for the Meeting Room Booking System assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://meeting-room-booking-backend-il7g.onrender.com"
    },
    {
      "key": "bookingId",
      "value": "1"
    },
    {
      "key": "roomId",
      "value": "1"
    },
    {
      "key": "date",
      "value": "2026-10-05"
    }
  ],
  "item": [
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Get All Rooms",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms"
          }
        },
        {
          "name": "Get Next Available Slot",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}/next-available?date={{date}}&duration=60"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Get Bookings By Date",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings?date={{date}}"
          }
        },
        {
          "name": "Get Bookings By Date And Room",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings?date={{date}}&roomId={{roomId}}"
          }
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 1,\n  \"title\": \"Team Meeting\",\n  \"date\": \"2026-10-05\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"11:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          }
        }
      ]
    }
  ]
}